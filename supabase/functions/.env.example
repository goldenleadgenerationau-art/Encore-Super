# Edge Function secrets — set with `supabase secrets set --env-file supabase/functions/.env`.
# Never commit the real values. SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
# are injected automatically by Supabase and do NOT need to be set here.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Two separate Catalog subscription plan variations — $12.99/month and $99/year.
SQUARE_PLAN_VARIATION_ID_MONTHLY=
SQUARE_PLAN_VARIATION_ID_YEARLY=
SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2026-05-20
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=

# For the notify-signup function — sends internal sign-up alerts to sales@encoresuper.com.au.
RESEND_API_KEY=
